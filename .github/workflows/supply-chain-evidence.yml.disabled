name: Supply Chain Evidence

on:
  workflow_dispatch:
  pull_request:
    branches:
      - main
      - develop
  schedule:
    - cron: "0 6 * * *"

permissions:
  contents: read
  pull-requests: read

jobs:
  dependency-review:
    if: ${{ github.event_name == 'pull_request' }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Dependency review
        uses: actions/dependency-review-action@v4
        with:
          fail-on-severity: high

  frontend-npm-audit:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: frontend/package-lock.json

      - name: Install frontend dependencies
        working-directory: frontend
        run: npm ci

      - name: Run npm audit
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p artifacts
          (
            cd frontend
            npm audit --omit=dev --audit-level=high --json
          ) | tee artifacts/frontend-npm-audit.json

      - name: Upload frontend audit artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: frontend-npm-audit
          path: artifacts/frontend-npm-audit.json
          retention-days: 30

  python-pip-audit:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install pip-audit
        run: python -m pip install --upgrade pip pip-audit

      - name: Verify launch-scope dependency policy
        run: python scripts/supply_chain/verify_launch_scope_dependency_policy.py --artifacts-dir artifacts/supply-chain

      - name: Run pip-audit against effective launch install plans
        run: python scripts/supply_chain/run_launch_python_supply_chain_gate.py --artifacts-dir artifacts/supply-chain

      - name: Upload Python audit artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: pip-audit-launch-scope
          path: artifacts/supply-chain
          retention-days: 30
          if-no-files-found: error

  sbom-and-fs-scan:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Stage launch-scope filesystem bundle
        shell: bash
        run: |
          set -euo pipefail
          rm -rf artifacts/launch-scope-fs
          bash ./scripts/supply_chain/stage_launch_scope_filesystem.sh artifacts/launch-scope-fs

      - name: Generate launch-scope CycloneDX SBOM
        uses: anchore/sbom-action@v0
        with:
          path: artifacts/launch-scope-fs
          format: cyclonedx-json
          output-file: artifacts/launch-scope-sbom.cdx.json

      - name: Run Trivy launch-scope filesystem scan
        uses: aquasecurity/trivy-action@0.28.0
        with:
          scan-type: fs
          scan-ref: artifacts/launch-scope-fs
          scanners: vuln
          format: json
          output: artifacts/trivy-fs-launch-scope.json
          severity: CRITICAL,HIGH
          exit-code: "1"

      - name: Upload SBOM and Trivy artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: supply-chain-evidence
          path: |
            artifacts/launch-scope-fs
            artifacts/launch-scope-sbom.cdx.json
            artifacts/trivy-fs-launch-scope.json
          retention-days: 30
          if-no-files-found: error

  launch-image-scan:
    if: ${{ github.event_name != 'pull_request' }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build narrowed launch images locally
        shell: bash
        run: |
          set -euo pipefail
          bash ./scripts/supply_chain/build_launch_scope_images.sh \
            --artifacts-dir artifacts/launch-images \
            --image-tag "${GITHUB_SHA}"

      - name: Run Trivy launch-image scans
        shell: bash
        run: |
          set -euo pipefail
          bash ./scripts/supply_chain/scan_launch_scope_images.sh --artifacts-dir artifacts/launch-images

      - name: Upload launch-image scan artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: launch-image-scan-evidence
          path: artifacts/launch-images
          retention-days: 30
          if-no-files-found: error
