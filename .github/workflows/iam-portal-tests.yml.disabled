name: IAM Portal Tests

on:
  push:
    branches: [ main, develop ]
    paths:
      - 'backend/services/iam_agent/**'
      - 'frontend/src/app/dashboard/iam/**'
      - 'frontend/src/components/iam/**'
      - 'frontend/src/lib/api/iam-portal.ts'
      - 'backend/migrations/015_iam_portal_schema.sql'
      - 'backend/migrations/016_iam_policies_schema.sql'
      - 'scripts/iam-portal-smoke-test.sh'
      - '.github/workflows/iam-portal-tests.yml'
  pull_request:
    branches: [ main, develop ]
    paths:
      - 'backend/services/iam_agent/**'
      - 'frontend/src/app/dashboard/iam/**'
      - 'frontend/src/components/iam/**'
      - 'frontend/src/lib/api/iam-portal.ts'
      - 'backend/migrations/015_iam_portal_schema.sql'
      - 'backend/migrations/016_iam_policies_schema.sql'
      - 'scripts/iam-portal-smoke-test.sh'
  workflow_dispatch:  # Allow manual triggering

jobs:
  iam-portal-smoke-tests:
    name: IAM Portal Smoke Tests
    runs-on: ubuntu-latest
    timeout-minutes: 15

    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_USER: sg
          POSTGRES_PASSWORD: sg
          POSTGRES_DB: sg
        options: >-
          --health-cmd "pg_isready -U sg"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

      keycloak:
        image: quay.io/keycloak/keycloak:25.0.6
        env:
          KEYCLOAK_ADMIN: admin
          KEYCLOAK_ADMIN_PASSWORD: admin
          KC_DB: postgres
          KC_DB_URL_HOST: postgres
          KC_DB_URL_DATABASE: keycloak
          KC_DB_USERNAME: keycloak
          KC_DB_PASSWORD: keycloak
          KC_HEALTH_ENABLED: true
        options: >-
          --health-cmd "curl -f http://localhost:8080/health/ready || exit 1"
          --health-interval 30s
          --health-timeout 10s
          --health-retries 10
          --health-start-period 60s
        ports:
          - 8080:8080

      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Python dependencies
        run: |
          pip install --upgrade pip
          pip install httpx python-keycloak sqlalchemy psycopg2-binary

      - name: Wait for Keycloak to be ready
        run: |
          echo "Waiting for Keycloak to be ready..."
          for i in {1..60}; do
            if curl -f -s http://localhost:8080/health/ready > /dev/null 2>&1; then
              echo "Keycloak is ready!"
              break
            fi
            echo "Waiting... ($i/60)"
            sleep 2
          done
          # Additional wait for Keycloak to fully initialize
          sleep 10

      - name: Apply database migrations
        run: |
          PGPASSWORD=sg psql -h localhost -U sg -d sg -f backend/migrations/015_iam_portal_schema.sql || echo "Migration may already be applied"
          PGPASSWORD=sg psql -h localhost -U sg -d sg -f backend/migrations/016_iam_policies_schema.sql || echo "Migration may already be applied"

      - name: Start IAM Agent
        run: |
          cd backend/services/iam_agent
          pip install -r requirements.txt || true
          # Start IAM Agent in background
          python -m uvicorn app.main:app --host 0.0.0.0 --port 8005 &
          IAM_AGENT_PID=$!
          echo "IAM_AGENT_PID=$IAM_AGENT_PID" >> $GITHUB_ENV
          
          # Wait for IAM Agent to be ready
          echo "Waiting for IAM Agent to be ready..."
          for i in {1..30}; do
            if curl -f -s http://localhost:8005/health > /dev/null 2>&1; then
              echo "IAM Agent is ready!"
              break
            fi
            echo "Waiting... ($i/30)"
            sleep 2
          done

      - name: Seed Keycloak (if needed)
        run: |
          # Trigger seeding by calling health endpoint
          # The IAM Agent should auto-seed on startup
          curl -s http://localhost:8005/health | python3 -m json.tool || true
          sleep 5

      - name: Run IAM Portal smoke tests
        run: |
          chmod +x scripts/iam-portal-smoke-test.sh
          # Modify script to work in CI (use localhost instead of docker-compose exec)
          export KEYCLOAK_URL=http://localhost:8080
          export IAM_AGENT_URL=http://localhost:8005
          
          # Get admin token
          TOKEN=$(curl -s -X POST http://localhost:8080/realms/sentinelgrid/protocol/openid-connect/token \
            -d "client_id=sentinelgrid-web" \
            -d "username=admin@sentinelgrid.ai" \
            -d "password=admin123" \
            -d "grant_type=password" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('access_token',''))")
          
          if [ -z "$TOKEN" ] || [ ${#TOKEN} -lt 100 ]; then
            echo "❌ Failed to obtain admin token"
            exit 1
          fi
          
          echo "✅ Obtained admin token"
          
          API_BASE="http://localhost:8005/api/iam-portal"
          
          # Test 1: List users
          echo "Testing: GET /users"
          RESPONSE=$(curl -s -w "\nHTTP_CODE:%{http_code}" -H "Authorization: Bearer $TOKEN" "$API_BASE/users")
          HTTP_CODE=$(echo "$RESPONSE" | grep "HTTP_CODE" | cut -d: -f2)
          BODY=$(echo "$RESPONSE" | sed '/HTTP_CODE/d')
          
          if [ "$HTTP_CODE" != "200" ]; then
            echo "❌ GET /users failed (HTTP $HTTP_CODE)"
            echo "$BODY"
            exit 1
          fi
          echo "✅ GET /users succeeded"
          
          # Test 2: Create user
          echo "Testing: POST /users"
          TS=$(date +%s)
          RND=$RANDOM
          TEST_USERNAME="ci-test-${TS}-${RND}@example.com"
          
          CREATE_RESPONSE=$(curl -s -w "\nHTTP_CODE:%{http_code}" -X POST "$API_BASE/users" \
            -H "Authorization: Bearer $TOKEN" \
            -H "Content-Type: application/json" \
            -d "{
              \"username\": \"${TEST_USERNAME}\",
              \"email\": \"${TEST_USERNAME}\",
              \"first_name\": \"CI\",
              \"last_name\": \"Test\",
              \"department\": \"Engineering\"
            }")
          
          HTTP_CODE=$(echo "$CREATE_RESPONSE" | grep "HTTP_CODE" | cut -d: -f2)
          BODY=$(echo "$CREATE_RESPONSE" | sed '/HTTP_CODE/d')
          
          if [ "$HTTP_CODE" != "200" ] && [ "$HTTP_CODE" != "201" ]; then
            echo "❌ POST /users failed (HTTP $HTTP_CODE)"
            echo "$BODY"
            exit 1
          fi
          echo "✅ POST /users succeeded"
          
          # Test 3: List users again to verify creation
          echo "Testing: GET /users (verify creation)"
          RESPONSE=$(curl -s -w "\nHTTP_CODE:%{http_code}" -H "Authorization: Bearer $TOKEN" "$API_BASE/users")
          HTTP_CODE=$(echo "$RESPONSE" | grep "HTTP_CODE" | cut -d: -f2)
          BODY=$(echo "$RESPONSE" | sed '/HTTP_CODE/d')
          
          if [ "$HTTP_CODE" != "200" ]; then
            echo "❌ GET /users failed (HTTP $HTTP_CODE)"
            exit 1
          fi
          
          # Verify user was created
          if echo "$BODY" | grep -q "$TEST_USERNAME"; then
            echo "✅ User creation verified"
          else
            echo "⚠️  User may not appear in list immediately"
          fi
          
          echo ""
          echo "=========================================="
          echo "✅ All IAM Portal smoke tests passed!"
          echo "=========================================="

      - name: Cleanup
        if: always()
        run: |
          if [ -n "$IAM_AGENT_PID" ]; then
            kill $IAM_AGENT_PID 2>/dev/null || true
          fi

