name: Rebrand Agents

on:
  schedule:
    - cron: '0 2 * * 0'  # Weekly on Sunday 2 AM UTC
  workflow_dispatch:
    inputs:
      wazuh_version:
        description: 'Wazuh version to download'
        required: false
        default: '4.8.0'
      sentinelgrid_version:
        description: 'SentinelGrid version'
        required: false
        default: '1.0.0'

jobs:
  download-and-rebrand:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - name: Set up environment
        run: |
          export WAZUH_VERSION=${WAZUH_VERSION:-${{ github.event.inputs.wazuh_version || '4.8.0' }}}
          export SENTINELGRID_VERSION=${SENTINELGRID_VERSION:-${{ github.event.inputs.sentinelgrid_version || '1.0.0' }}}
          echo "WAZUH_VERSION=$WAZUH_VERSION" >> $GITHUB_ENV
          echo "SENTINELGRID_VERSION=$SENTINELGRID_VERSION" >> $GITHUB_ENV
      
      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y wget rpm2cpio cpio dpkg-deb
      
      - name: Download Wazuh agents
        run: |
          chmod +x scripts/rebrand-agents/download/download-wazuh.sh
          ./scripts/rebrand-agents/download/download-wazuh.sh
      
      - name: Rebrand agents
        run: |
          chmod +x scripts/rebrand-agents/rebrand/rebrand-wazuh.sh
          ./scripts/rebrand-agents/rebrand/rebrand-wazuh.sh
      
      - name: Build packages
        run: |
          chmod +x scripts/rebrand-agents/build/build-packages.sh
          ./scripts/rebrand-agents/build/build-packages.sh
      
      - name: Test packages
        run: |
          chmod +x scripts/rebrand-agents/test/test-rebranded-agent.sh
          ./scripts/rebrand-agents/test/test-rebranded-agent.sh
      
      - name: Upload artifacts
        uses: actions/upload-artifact@v3
        with:
          name: rebranded-agents
          path: |
            agents-built/
            agents-rebranded/
          retention-days: 30
      
      - name: Upload to CDN (if configured)
        if: env.AWS_ACCESS_KEY_ID != ''
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          CDN_BUCKET: ${{ secrets.CDN_BUCKET }}
        run: |
          chmod +x scripts/rebrand-agents/upload/upload-to-cdn.sh
          ./scripts/rebrand-agents/upload/upload-to-cdn.sh

