# Database used by the services app.
POSTGRES_DB=sentinelgrid_ai_shield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=postgresql://postgres:postgres@postgres:5432/sentinelgrid_ai_shield

# Shared token between gateway and services for internal key lookup.
INTERNAL_SERVICE_TOKEN=internal-service-token
LOG_LEVEL=INFO
TELEMETRY_MODE=http

# External SIEM export contract.
# The current runtime implements Splunk HEC delivery.
# Sentinel and QRadar remain documented interface examples on the same contract.
# See docs/siem-export.md and schemas/siem-export-config.schema.json.
SIEM_EXPORT_ENABLED=false
SIEM_EXPORT_CONFIG_FILE=/app/config/siem-destinations.yaml
SIEM_EXPORT_BATCH_SIZE=100
SIEM_EXPORT_TIMEOUT_SECONDS=10
SIEM_EXPORT_RETRY_MAX=3
SPLUNK_HEC_TOKEN=

# Optional platform integration.
# When enabled, risky AI events are forwarded into the main SentinelGrid
# alert/incident workflow after the local telemetry write commits.
PLATFORM_ALERT_INGEST_ENABLED=false
PLATFORM_API_URL=http://api_gateway:8000
PLATFORM_ALERT_INGEST_PATH=/api/v1/internal/ai-shield/events
PLATFORM_ALERT_INGEST_TIMEOUT_SECONDS=10

# Provider keys for local development.
# The services app exposes these to the gateway over the internal key endpoint.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional override if you are targeting an OpenAI-compatible endpoint other than api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1
