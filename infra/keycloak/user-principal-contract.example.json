{
  "clientId": "review-browser",
  "protocol": "openid-connect",
  "publicClient": true,
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": true,
  "implicitFlowEnabled": false,
  "serviceAccountsEnabled": false,
  "attributes": {
    "standard.token.exchange.enabled": "false",
    "oauth2.jwt.authorization.grant.enabled": "false"
  },
  "protocolMappers": [
    {
      "name": "sentinelgrid-sg_principal_type",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "sg_principal_type",
        "claim.value": "user",
        "jsonType.label": "String",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "userinfo.token.claim": "false"
      }
    },
    {
      "name": "sentinelgrid-sg_identity_contract",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "sg_identity_contract",
        "claim.value": "keycloak-user-v1",
        "jsonType.label": "String",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "userinfo.token.claim": "false"
      }
    }
  ]
}
