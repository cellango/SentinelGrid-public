{
  "clientId": "review-ticket-reader",
  "enabled": false,
  "protocol": "openid-connect",
  "publicClient": false,
  "clientAuthenticatorType": "client-secret",
  "bearerOnly": false,
  "serviceAccountsEnabled": true,
  "standardFlowEnabled": false,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "authorizationServicesEnabled": false,
  "fullScopeAllowed": false,
  "redirectUris": [],
  "webOrigins": [],
  "defaultClientScopes": [],
  "optionalClientScopes": [],
  "attributes": {
    "access.token.lifespan": "30",
    "use.refresh.tokens": "false",
    "client_credentials.use_refresh_token": "false",
    "standard.token.exchange.enabled": "false",
    "oauth2.jwt.authorization.grant.enabled": "false"
  },
  "protocolMappers": [
    {
      "name": "sentinelgrid-tenant_id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "tenant_id",
        "claim.value": "11111111-1111-4111-8111-111111111111",
        "jsonType.label": "String",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "sentinelgrid-sg_principal_type",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "sg_principal_type",
        "claim.value": "workload",
        "jsonType.label": "String",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "sentinelgrid-sg_identity_contract",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "sg_identity_contract",
        "claim.value": "keycloak-workload-read-v1",
        "jsonType.label": "String",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "sentinelgrid-sg_permissions",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "sg_permissions",
        "claim.value": "[\"ticketing.read\"]",
        "jsonType.label": "JSON",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "sentinelgrid-sg_request",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "sg_request",
        "claim.value": "{\"method\":\"GET\",\"path\":\"/api/v1/tickets\",\"query_sha256\":\"27ac3a554f00a7131bf07486ffbfde03583391bec03db0252933fde1fb633393\",\"service_id\":\"ticketing_service\"}",
        "jsonType.label": "JSON",
        "access.token.claim": "true",
        "id.token.claim": "false",
        "userinfo.token.claim": "false",
        "access.tokenResponse.claim": "false"
      }
    },
    {
      "name": "sentinelgrid-audience-0",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "included.custom.audience": "sentinelgrid-web",
        "access.token.claim": "true",
        "id.token.claim": "false"
      }
    },
    {
      "name": "sentinelgrid-audience-1",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "included.custom.audience": "urn:sentinelgrid:service:ticketing_service",
        "access.token.claim": "true",
        "id.token.claim": "false"
      }
    }
  ]
}
