{
  "index_patterns": ["sg-ai-events-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "id": {
          "type": "keyword"
        },
        "org_id": {
          "type": "keyword"
        },
        "ai_app_id": {
          "type": "keyword"
        },
        "user_id": {
          "type": "keyword"
        },
        "provider": {
          "type": "keyword"
        },
        "model": {
          "type": "keyword"
        },
        "has_pii": {
          "type": "boolean"
        },
        "has_secrets": {
          "type": "boolean"
        },
        "prompt_injection_suspected": {
          "type": "boolean"
        },
        "policy_decision": {
          "type": "keyword"
        },
        "violation_reason": {
          "type": "text"
        },
        "tokens_in": {
          "type": "integer"
        },
        "tokens_out": {
          "type": "integer"
        },
        "prompt_preview": {
          "type": "text",
          "index": false
        },
        "response_preview": {
          "type": "text",
          "index": false
        },
        "created_at": {
          "type": "date"
        }
      }
    }
  },
  "priority": 100
}

