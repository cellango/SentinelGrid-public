# Copy this file to scripts/audit/multi-tenancy/config/audit-pack.env for local overrides.

AUDIT_OPERATOR=
AUDIT_TENANT_A_ID=
AUDIT_TENANT_B_ID=
AUDIT_TENANT_A_REALM=
AUDIT_TENANT_B_REALM=
API_GATEWAY_URL=http://localhost:8082
IAM_AGENT_URL=http://localhost:8005
KEYCLOAK_URL=https://localhost:8443
POSTGRES_URL=postgresql://sg:sg@localhost:5432/sg
POSTGRES_ADMIN_URL=postgresql://sg:sg@localhost:5432/sg
AUDIT_ENABLE_LIVE_RLS_PREP=true
AUDIT_PROVISION_RLS_VERIFIER=false
AUDIT_DISCOVERY_PER_TABLE_LIMIT=5
AUDIT_RLS_VERIFIER_ROLE=sg_audit_verifier
AUDIT_RLS_VERIFIER_PASSWORD=sg_audit_verifier
AUDIT_REQUIRE_LIVE_RLS=false
AUDIT_RLS_LIVE_SAMPLE_LIMIT=5
AUDIT_ENABLE_REMEDIATION_REPORT=true
AUDIT_ENABLE_OWNER_QUEUES=true
AUDIT_ENABLE_REMEDIATION_PROGRAM=true
