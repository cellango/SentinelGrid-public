# Multi-stage build for SentinelGuard server
FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY . .
RUN go build -o /out/sentinelguard-server ./cmd/server

FROM alpine:3.19
WORKDIR /srv
COPY --from=builder /out/sentinelguard-server /usr/local/bin/sentinelguard-server
EXPOSE 8085
ENTRYPOINT ["/usr/local/bin/sentinelguard-server"]
